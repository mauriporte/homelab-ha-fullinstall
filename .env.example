# Copy to .env and edit. Secrets (VPN password, tunnel token) are better kept in secrets.enc.env,
# encrypted with sops + age (see docs/secrets.md); install.sh decrypts it next to this file at start.

TZ=Etc/UTC
PUID=1000
PGID=1000

# Where app data and media live on this server
DATA_DIR=/srv/homelab
MEDIA_DIR=/srv/media
DOWNLOADS_DIR=/srv/media/downloads
PHOTOS_DIR=/srv/photos

# Home Assistant: stable, or a pinned version like 2026.10.2
HA_VERSION=stable

# VPN for qBittorrent (gluetun). Provider names: https://github.com/qdm12/gluetun-wiki
VPN_PROVIDER=protonvpn
VPN_COUNTRY=Netherlands
VPN_FREE_ONLY=off
VPN_USER=
VPN_PASSWORD=

# Immich: release, or a pinned version like v1.2.3
IMMICH_VERSION=release

# Invidious: the public hostname you'll use (e.g. video.example.com), https only when behind a tunnel/proxy
INVIDIOUS_DOMAIN=
INVIDIOUS_HTTPS_ONLY=false
INVIDIOUS_EXTERNAL_PORT=

# DNS module: hostnames kept pointing at your home IP (comma-separated)
DDNS_DOMAINS=

# rclone module
RCLONE_REMOTE=gdrive:
RCLONE_DLNA_NAME=Cloud drive
RCLONE_DLNA_PORT=7879

# Tailscale
TAILSCALE_HOSTNAME=homelab
TAILSCALE_EXTRA_ARGS=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install command)
CLOUDFLARE_TUNNEL_TOKEN=

# Ports (change only if they clash with something on the host)
KUMA_PORT=3001
GLANCES_PORT=61208
PORTAINER_PORT=9443
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
PROWLARR_PORT=9696
FLARESOLVERR_PORT=8191
QBIT_PORT=8080
THREADFIN_PORT=34400
TVH_PORT=9981
STALWART_WEB_PORT=8090
SYNCTHING_PORT=8384
JACKETT_PORT=9117
IMMICH_PORT=2283
OLLAMA_PORT=11434
INVIDIOUS_PORT=3000
STREMIO_WEB_PORT=8095
EPG_PORT=3002
IPTV_PUBLIC_PORT=8099
