# Names of the secrets install.sh expects. Copy to secrets.env, fill in, encrypt (docs/secrets.md), delete secrets.env.
# Generate random values with: openssl rand -hex 16   (use exactly 16 characters for INVIDIOUS_COMPANION_KEY)
VPN_USER=
VPN_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_DNS_TOKEN=
IMMICH_DB_PASSWORD=
INVIDIOUS_DB_PASSWORD=
INVIDIOUS_HMAC_KEY=
INVIDIOUS_COMPANION_KEY=
TAILSCALE_AUTHKEY=
IPTV_PUBLIC_KEY=
